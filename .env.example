# ---------------------------------------------------------------------------
# Variorum — environment template
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
APP_NAME=Variorum
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000
# Public base URL of the backend (used to build GitHub webhook/callback URLs)
BACKEND_PUBLIC_URL=http://localhost:8000
# Public base URL of the frontend
FRONTEND_URL=http://localhost:3000
# Secret used to sign app session cookies (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Session cookie SameSite policy: "lax" for same-site/local or a same-origin
# proxy; "none" for a split-domain deploy (frontend and backend on different
# origins). "none" requires HTTPS (Secure is enabled automatically in prod).
SESSION_COOKIE_SAMESITE=lax
# Abuse rate limiting on auth/webhook/AI endpoints (default true).
RATE_LIMIT_ENABLED=true
# Use the pgvector-accelerated semantic search path when the extension and
# column are present (default true); falls back to in-process cosine otherwise.
PGVECTOR_ENABLED=true

# --- Database connection pool (per process) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Database (PostgreSQL 17) ---
# Default targets a local PostgreSQL on 5432 (native install). If you instead
# use the bundled Docker database (docker compose up -d db), it is published on
# host port 5433 to avoid clashing with a native server — use ...@localhost:5433.
DATABASE_URL=postgresql+psycopg://variorum:variorum@localhost:5432/variorum

# --- AI providers -----------------------------------------------------------
# At least one provider key must be set for analysis features to work.
# Fallback order is: Gemini key 1 -> Gemini key 2 -> DeepSeek -> Perplexity.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides. The defaults below are verified working:
#   - gemini-flash-latest  (available on both free-tier and paid keys)
#   - deepseek-v4-flash    (DeepSeek's current model family)
#   - sonar                (Perplexity)
# Leave blank to use these defaults.
GEMINI_MODEL=gemini-flash-latest
DEEPSEEK_MODEL=deepseek-v4-flash
PERPLEXITY_MODEL=sonar

# --- GitHub App -------------------------------------------------------------
# Create a GitHub App (see README "GitHub App setup"). These come from its
# settings page. The private key is a .pem you download from GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Webhook secret you set when creating the App (used to verify signatures).
GITHUB_WEBHOOK_SECRET=
# Provide the private key EITHER as a file path OR as a base64-encoded string.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
