# ---------------------------------------------------------------------------
# Variorum — environment template
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
APP_NAME=Variorum
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000
# Public base URL of the backend (used to build GitHub webhook/callback URLs)
BACKEND_PUBLIC_URL=http://localhost:8000
# Public base URL of the frontend
FRONTEND_URL=http://localhost:3000
# Secret used to sign app session cookies (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (PostgreSQL 17) ---
# Matches docker-compose.yml. Host port 5433 is used so the container does not
# clash with a native PostgreSQL that may already be running on 5432.
DATABASE_URL=postgresql+psycopg://variorum:variorum@localhost:5433/variorum

# --- AI providers -----------------------------------------------------------
# At least one provider key must be set for analysis features to work.
# Fallback order is: Gemini key 1 -> Gemini key 2 -> DeepSeek -> Perplexity.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides (sensible defaults are used if left blank)
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_MODEL=sonar

# --- GitHub App -------------------------------------------------------------
# Create a GitHub App (see README "GitHub App setup"). These come from its
# settings page. The private key is a .pem you download from GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Webhook secret you set when creating the App (used to verify signatures).
GITHUB_WEBHOOK_SECRET=
# Provide the private key EITHER as a file path OR as a base64-encoded string.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
